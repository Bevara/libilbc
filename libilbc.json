{
    "name": "libilbc",
    "version": "1.0.2",
    "description": "iLBC (Internet Low Bitrate Codec) decoder",
    "filters":["ilbcdec"],
    "help": "This filter decodes iLBC speech files using libilbc.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libilbc.accessor",
    "filter_source":{
        "ilbcdec" : "dec_ilbc.c"
    },
    "extension":{
      "lbc" : "audio"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1"],
    "patents": {
        "status": "royalty-free",
        "note": "iLBC, royalty-free (RFC 3951)",
        "checked": "2026-10-16"
    }
}
